{
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "1.2.7",
  "manifest_version": 3,
  "icons": {
    "16": "img/icon16.png",
    "19": "img/icon19.png",
    "38": "img/icon38.png",
    "128": "img/icon128.png"
  },
  "action": {
    "default_icon": {
      "19": "img/icon19.png",
      "38": "img/icon38.png"
    },
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "__MSG_openPopupSetting__"
    }
  },
  "options_page": "options.html",
  "default_locale": "en",
  "permissions": [
    "downloads",
    "downloads.open",
    "downloads.shelf",
    "downloads.ui",
    "storage",
    "notifications",
    "contextMenus",
    "offscreen",
    "alarms"
  ],
  "homepage_url": "https://github.com/xinghaix/download-manager",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "109"
}
